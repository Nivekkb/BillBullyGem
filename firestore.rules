rules_version = '2';

/**
 * @file firestore.rules
 * @description Firestore Security Rules for the BillBully application.
 *
 * @section Core Philosophy
 * This ruleset enforces a strict user-ownership model. All user-generated data,
 * such as bills, credit items, and subscriptions, is stored in subcollections
 * under that user's specific document. Access is granted only if the requesting
 * user's authenticated UID matches the user ID in the document path. This ensures
 * that users can only ever access their own data.
 *
 * @section Data Structure
 * All data is hierarchically organized under the `/users/{userId}` collection.
 * This structure provides a secure and efficient way to scope data access, as
 * rules can leverage the path itself for authorization without needing extra
 * database reads.
 *   - /users/{userId} - The root document for a user's profile.
 *   - /users/{userId}/bills/{billId} - A user's private bills.
 *   - /users/{userId}/credit_items/{creditItemId} - A user's private credit items.
 *   - /users/{userId}/credit_items/{creditItemId}/dispute_letters/{disputeLetterId} - Letters associated with a credit item.
 *   - /users/{userId}/subscriptions/{subscriptionId} - A user's private subscriptions.
 *
 * @section Key Security Decisions
 * - Default Deny: All paths are closed by default. Access must be explicitly granted.
 * - User Enumeration Prevention: Listing the top-level `/users` collection is disallowed
 *   to prevent attackers from discovering user IDs.
 * - Path-Based Authorization: Rules rely on the `{userId}` wildcard in the path,
 *   which is fast, cost-effective, and not subject to query limitations.
 * - Prototyping Flexibility: Data shape validation is intentionally omitted to allow
 *   for rapid iteration on the client-side. Rules only validate fields critical
 *   for maintaining ownership and relational integrity (e.g., `userId`).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if a user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the requesting user is the owner of the document based on the
     * userId parameter from the path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the requesting user is the owner of an existing document.
     * CRITICAL: Use this for all update and delete operations to prevent writes
     * to non-existent documents.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Rules for a user's profile document.
     * @path /users/{userId}
     * @allow (get, update, delete) An authenticated user can read, update, or delete their own profile.
     * @allow (create) An authenticated user can create their own profile document.
     * @deny (list) Listing the top-level users collection is forbidden to prevent user enumeration.
     * @deny (create, update) A user cannot create or update a profile for another user.
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for a user's bills subcollection.
       * @path /users/{userId}/bills/{billId}
       * @allow (get, list, create, update, delete) A user can perform all operations on their own bills.
       * @deny (any) Another user cannot access or modify these bills in any way.
       * @principle Enforces strict ownership for a user's private data subcollection.
       */
      match /bills/{billId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Rules for a user's credit items subcollection.
       * @path /users/{userId}/credit_items/{creditItemId}
       * @allow (get, list, create, update, delete) A user can perform all operations on their own credit items.
       * @deny (any) Another user cannot access or modify these credit items in any way.
       * @principle Enforces strict ownership for a user's private data subcollection.
       */
      match /credit_items/{creditItemId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        /**
         * @description Rules for dispute letters, which are nested under a credit item.
         * @path /users/{userId}/credit_items/{creditItemId}/dispute_letters/{disputeLetterId}
         * @allow (any) The user who owns the parent credit item can fully manage its dispute letters.
         * @deny (any) Another user cannot access or modify these dispute letters.
         * @principle Ownership is inherited from the parent document's path.
         */
        match /dispute_letters/{disputeLetterId} {
          allow get: if isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isOwner(userId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }
      }

      /**
       * @description Rules for a user's subscriptions subcollection.
       * @path /users/{userId}/subscriptions/{subscriptionId}
       * @allow (get, list, create, update, delete) A user can perform all operations on their own subscriptions.
       * @deny (any) Another user cannot access or modify these subscriptions in any way.
       * @principle Enforces strict ownership for a user's private data subcollection.
       */
      match /subscriptions/{subscriptionId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }
    }
  }
}